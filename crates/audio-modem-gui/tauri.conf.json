{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stego-flac",
  "version": "0.2.0",
  "identifier": "com.seky443.stegoflac",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../apps/desktop",
    "beforeBuildCommand": "npm run build --prefix ../apps/desktop",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "title": "stego-flac",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
